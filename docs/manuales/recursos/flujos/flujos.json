      },
      {
        "area": "APP IONIC",
        "texto": "La variable global de Ionic aplica la fuente"
      },
      {
        "area": "APP IONIC",
        "texto": "El texto de las páginas usa la fuente"
      },
      {
        "area": "APP IONIC",
        "texto": "Las variables definen el color personalizado",
