      },
      {
        "area": "DIRECTUS",
        "texto": "Devuelve la respuesta"
      },
      {
        "area": "APP IONIC",
        "texto": "map extrae el dato del cuerpo"
      },
      {
        "area": "APP IONIC",
        "texto": "firstValueFrom entrega el resultado a la página"
      },
      {
        "area": "APP IONIC",
        "texto": "La página actualiza su vista"
      }
    ]
  },
  {
    "nombre": "12-sesion",
    "titulo": "Registrar una cuenta e iniciar sesión",
    "pasos": [
      {
        "area": "USUARIO",
        "texto": "Completa el formulario de registro",
        "nota": "Este recorrido comienza con registro; una cuenta activa puede ir directamente al acceso."
      },
      {
        "area": "APP IONIC",
        "texto": "Envía POST /users/register"
      },
      {
        "area": "DIRECTUS",
        "texto": "Procesa la solicitud de registro",
        "nota": "La verificación depende de la configuración de Directus."
      },
      {
        "area": "USUARIO",
        "texto": "Completa la verificación, si se solicita, y abre el acceso"
      },
      {
        "area": "APP IONIC",
        "texto": "Valida correo y contraseña; envía POST /auth/login"
      },
      {
        "area": "DIRECTUS",
        "texto": "Devuelve una sesión con vigencia"
      },
      {
        "area": "APP IONIC",
        "texto": "El cliente agrega Bearer a las consultas"
      },
      {
        "area": "DIRECTUS",
        "texto": "Aplica los permisos de la cuenta"
      }
    ]
  },
  {
    "nombre": "13-guard",
