      {
        "area": "APP IONIC",
        "texto": "Si no es válida, abre Login con returnUrl"
      },
      {
        "area": "USUARIO",
        "texto": "Ingresa sus credenciales"
      },
      {
        "area": "DIRECTUS",
        "texto": "Autentica la cuenta"
      },
      {
        "area": "APP IONIC",
        "texto": "Vuelve a validar y abre la ruta solicitada"
      }
    ]
  },
