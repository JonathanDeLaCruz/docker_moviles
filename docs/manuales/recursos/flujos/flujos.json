[
  {
    "nombre": "01-listado",
    "titulo": "Consultar y mostrar productos",
    "pasos": [
      {
        "area": "USUARIO",
        "texto": "Abre Productos"
      },
      {
        "area": "APP IONIC",
        "texto": "ngOnInit() llama a cargarProductos()"
      },
      {
        "area": "APP IONIC",
        "texto": "Axios solicita GET /items/productos"
      },
      {
        "area": "DIRECTUS",
        "texto": "Recibe la petición y consulta la colección"
      },
      {
        "area": "MARIADB",
        "texto": "Entrega los registros a Directus"
      },
      {
        "area": "DIRECTUS",
        "texto": "Responde con JSON: { data: [...] }"
      },
      {
        "area": "APP IONIC",
        "texto": "Guarda response.data.data en productos"
      },
      {
        "area": "APP IONIC",
        "texto": "*ngFor recorre el arreglo"
      },
      {
        "area": "APP IONIC",
        "texto": "Muestra los productos en el listado"
      }
    ]
  },
  {
    "nombre": "02-detalle",
    "titulo": "Consultar el detalle de un producto",
    "pasos": [
      {
        "area": "USUARIO",
        "texto": "Presiona el icono de ojo"
      },
      {
        "area": "APP IONIC",
        "texto": "routerLink abre /productos-view/1"
      },
      {
        "area": "APP IONIC",
        "texto": "ngOnInit() llama a cargarProducto()"
      },
      {
        "area": "APP IONIC",
        "texto": "ActivatedRoute obtiene el ID y se muestra la carga"
      },
      {
        "area": "APP IONIC",
        "texto": "Axios solicita GET /items/productos/1"
      },
      {
        "area": "DIRECTUS",
        "texto": "Consulta el producto por ID"
      },
      {
        "area": "MARIADB",
        "texto": "Entrega el registro a Directus"
      },
      {
        "area": "DIRECTUS",
        "texto": "Devuelve un objeto dentro de data"
      },
      {
        "area": "APP IONIC",
        "texto": "Guarda response.data.data en producto"
      },
      {
        "area": "APP IONIC",
        "texto": "ngIf muestra la tarjeta; finally cierra la carga"
      }
    ]
  },
  {
    "nombre": "03-crear-modal",
    "titulo": "Crear un producto mediante un modal",
    "pasos": [
      {
        "area": "USUARIO",
        "texto": "Presiona + en el listado"
      },
      {
        "area": "APP IONIC",
        "texto": "nuevoProducto() crea y presenta el modal",
        "nota": "Cancelar: dismiss devuelve guardado: false; no crea ni recarga productos."
      },
      {
        "area": "USUARIO",
        "texto": "Captura los datos y presiona Guardar"
      },
      {
        "area": "APP IONIC",
        "texto": "Valida el formulario",
        "nota": "Si es inválido, getError() muestra mensajes y el usuario corrige los datos."
      },
      {
        "area": "APP IONIC",
        "texto": "Axios envía POST /items/productos"
      },
      {
        "area": "DIRECTUS",
        "texto": "Valida y solicita guardar el producto"
      },
      {
        "area": "MARIADB",
        "texto": "Guarda el registro y genera ID y fecha"
      },
      {
        "area": "DIRECTUS",
        "texto": "Devuelve la creación exitosa"
      },
      {
        "area": "APP IONIC",
        "texto": "Muestra Producto guardado"
      },
      {
        "area": "USUARIO",
        "texto": "Acepta; dismiss devuelve guardado: true"
      },
      {
        "area": "APP IONIC",
        "texto": "onDidDismiss() recibe el resultado y consulta el listado"
      },
      {
        "area": "APP IONIC",
        "texto": "Muestra el producto nuevo"
      }
    ]
  },
  {
    "nombre": "03-crear-pagina",
    "titulo": "Crear un producto mediante una página",
    "pasos": [
      {
        "area": "USUARIO",
        "texto": "Presiona +"
      },
      {
        "area": "APP IONIC",
        "texto": "Router abre /productos-form"
      },
      {
        "area": "APP IONIC",
        "texto": "ngOnInit() crea el formulario reactivo"
      },
      {
        "area": "USUARIO",
        "texto": "Captura los datos y presiona Guardar"
      },
      {
        "area": "APP IONIC",
        "texto": "Valida el formulario",
        "nota": "Si es inválido, markAllAsTouched() permite mostrar getError(); el usuario corrige los datos."
      },
      {
        "area": "APP IONIC",
        "texto": "Prepara el JSON y envía POST /items/productos"
      },
      {
        "area": "DIRECTUS",
        "texto": "Valida y solicita guardar el producto"
      },
      {
        "area": "MARIADB",
        "texto": "Guarda el producto y genera ID y fecha"
      },
      {
        "area": "DIRECTUS",
        "texto": "Devuelve la creación exitosa"
      },
      {
        "area": "APP IONIC",
        "texto": "Muestra Producto guardado"
      },
      {
        "area": "USUARIO",
        "texto": "Acepta la confirmación"
      },
      {
        "area": "APP IONIC",
        "texto": "Router vuelve al listado; ionViewWillEnter() consulta GET /items/productos"
      },
      {
        "area": "APP IONIC",
        "texto": "Muestra la colección actualizada"
      }
    ]
  },
  {
    "nombre": "04-actualizar-modal",
    "titulo": "Actualizar un producto mediante un modal",
    "pasos": [
      {
        "area": "USUARIO",
        "texto": "Presiona el lápiz del producto"
      },
      {
        "area": "APP IONIC",
        "texto": "Abre el modal con componentProps.id"
      },
      {
        "area": "APP IONIC",
        "texto": "Solicita GET del producto por ID"
      },
      {
        "area": "DIRECTUS",
        "texto": "Consulta el registro en MariaDB"
      },
      {
        "area": "MARIADB",
        "texto": "Entrega el registro actual"
      },
      {
        "area": "DIRECTUS",
        "texto": "Responde con los datos del producto"
      },
      {
        "area": "APP IONIC",
        "texto": "patchValue() llena el formulario"
      },
      {
        "area": "USUARIO",
        "texto": "Edita los datos y solicita guardar"
      },
      {
        "area": "APP IONIC",
        "texto": "Valida y envía PATCH a Directus"
      },
      {
        "area": "MARIADB",
        "texto": "Directus solicita guardar los cambios"
      },
      {
        "area": "APP IONIC",
        "texto": "Recibe la confirmación y dismiss devuelve guardado: true"
      },
      {
        "area": "APP IONIC",
        "texto": "El listado vuelve a consultar Directus"
      }
    ]
  },
  {
    "nombre": "04-actualizar-pagina",
    "titulo": "Actualizar un producto mediante una página",
    "pasos": [
      {
        "area": "USUARIO",
        "texto": "Presiona el lápiz del producto"
      },
      {
        "area": "APP IONIC",
        "texto": "Lee el ID y crea el formulario"
      },
      {
        "area": "APP IONIC",
        "texto": "Solicita GET /items/productos/{id}"
      },
      {
        "area": "DIRECTUS",
        "texto": "Consulta el producto en MariaDB"
      },
      {
        "area": "MARIADB",
        "texto": "Entrega el registro actual"
      },
      {
        "area": "DIRECTUS",
        "texto": "Responde con JSON que contiene data"
      },
      {
        "area": "APP IONIC",
        "texto": "patchValue() carga los campos"
      },
      {
        "area": "USUARIO",
        "texto": "Modifica y presiona Actualizar"
      },
      {
        "area": "APP IONIC",
        "texto": "Valida y envía PATCH /items/productos/{id}"
      },
      {
        "area": "DIRECTUS",
        "texto": "Solicita actualizar el registro en MariaDB"
      },
      {
        "area": "MARIADB",
        "texto": "Guarda los cambios"
      },
      {
        "area": "DIRECTUS",
        "texto": "Responde con éxito"
      },
      {
        "area": "APP IONIC",
        "texto": "Muestra Producto actualizado"
      },
      {
        "area": "USUARIO",
        "texto": "Acepta; Router regresa al listado"
      },
      {
        "area": "APP IONIC",
        "texto": "GET /items/productos obtiene la colección actualizada"
      }
    ]
  },
  {
    "nombre": "05-eliminar",
    "titulo": "Eliminar un producto con confirmación",
    "pasos": [
      {
        "area": "USUARIO",
        "texto": "Presiona la papelera del producto"
      },
      {
        "area": "APP IONIC",
        "texto": "Muestra la confirmación con nombre e ID",
        "nota": "Cancelar: cierra la confirmación sin enviar ninguna petición."
      },
      {
        "area": "USUARIO",
        "texto": "Confirma Eliminar"
      },
      {
        "area": "APP IONIC",
        "texto": "Envía DELETE a Directus"
      },
      {
        "area": "DIRECTUS",
        "texto": "Solicita eliminar el registro"
      },
      {
        "area": "MARIADB",
        "texto": "Elimina el producto"
      },
      {
        "area": "APP IONIC",
        "texto": "Recibe el éxito y muestra la alerta"
      },
      {
        "area": "APP IONIC",
        "texto": "GET obtiene el listado actualizado"
      }
    ]
  },
  {
    "nombre": "06-estilos",
    "titulo": "Aplicar la fuente y el color",
    "pasos": [
