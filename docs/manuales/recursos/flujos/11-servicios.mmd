flowchart TD
  A["La página llama a ProductosService"]
  OBS["El servicio devuelve un Observable"]
  SUB["firstValueFrom() se suscribe"]
  CALL["defer() ejecuta la llamada Axios"]
  API["Directus procesa la operación"]
  DB["MariaDB consulta o modifica los datos"]
  MAP["map() extrae o transforma la respuesta"]
  RESULT["firstValueFrom() resuelve la promesa"]
  VIEW["La página actualiza su vista"]
  ERROR["La promesa se rechaza y el catch de la página maneja el error"]
  A --> OBS
  OBS --> SUB
  SUB --> CALL
  CALL -->|"Petición HTTP"| API
  API --> DB
  DB -.-> API
  API -->|"Respuesta"| MAP
  MAP --> RESULT
  RESULT --> VIEW
  CALL -.->|"Falla la petición"| ERROR
