flowchart TD
  A["El usuario presiona el lápiz"]
  B["El modal recibe el ID en componentProps"]
  GET["Directus consulta el producto"]
  DBR["MariaDB devuelve los datos actuales"]
  FORM["patchValue() llena el formulario"]
  EDIT["El usuario modifica y solicita actualizar"]
  V{"¿Formulario válido?"}
  INVALID["Muestra los mensajes de validación"]
  PATCH["Directus recibe los cambios del producto"]
  DBW["MariaDB guarda los cambios"]
  OK["La app muestra Producto actualizado"]
  RETURN["Aceptar: dismiss devuelve guardado: true"]
  LIST["onDidDismiss() recarga los productos"]
  ERROR["catch muestra la alerta de error"]
  A --> B
  B -->|"GET por ID"| GET
  GET --> DBR
  DBR -.-> GET
  GET -->|"Registro actual"| FORM
  FORM --> EDIT
  EDIT --> V
  V -->|"No"| INVALID
  INVALID -.->|"Corregir"| EDIT
  V -->|"Sí: PATCH por ID"| PATCH
  PATCH --> DBW
  DBW -.-> PATCH
  PATCH -->|"Actualización exitosa"| OK
  OK --> RETURN
  RETURN --> LIST
  PATCH -.->|"Falla la actualización"| ERROR
