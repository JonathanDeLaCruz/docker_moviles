flowchart TD
  A["El usuario abre el listado"]
  COUNT["cargarTotal() solicita el conteo a Directus"]
  TOTAL["La app ajusta total y paginaActual"]
  GET["Directus procesa GET con limit, page y sort"]
  DB["MariaDB entrega los registros solicitados"]
  VIEW["La app muestra la lista y app-paginacion"]
  SELECT["El usuario selecciona otra página"]
  V{"¿Página válida y distinta?"}
  NO["El componente no emite ningún cambio"]
  CHANGE["paginaCambio actualiza paginaActual"]
  A --> COUNT
  COUNT --> TOTAL
  TOTAL --> GET
  GET --> DB
  DB -.-> GET
  GET -->|"Registros de la página"| VIEW
  VIEW --> SELECT
  SELECT --> V
  V -->|"No"| NO
  V -->|"Sí"| CHANGE
  CHANGE -.->|"Nueva consulta"| GET
