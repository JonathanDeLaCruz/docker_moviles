digraph Flujo {
  graph [rankdir=TB, bgcolor="#181818", pad="0.24", nodesep="0.42", ranksep="0.55", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#0e2a4d", color="#304b67", fontcolor="#b5d3f6", fontname="Arial", fontsize=17, penwidth=1.15, margin="0.22,0.20"];
  edge [color="#89929c", fontcolor="#b5d3f6", fontname="Arial", fontsize=13, arrowsize=0.65, penwidth=1.15];
  A [label="El usuario abre Imagen del\nproducto y elige un archivo", group=main];
  V [label="¿Archivo e ID\nválidos?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  NO [label="No inicia la subida"];
  FORM [label="FormData agrega el archivo\nen file", group=main];
  UPLOAD [label="POST /files envía el\narchivo a Directus", group=main];
  STORE [label="Archivo en almacenamiento y\nmetadatos en Directus"];
  PATCH [label="PATCH guarda el ID en\nproductos.imagen", group=main];
  GET [label="GET /assets/{id} solicita\nla imagen autenticada", group=main];
  BLOB [label="Blob y createObjectURL()\npreparan la vista", group=main];
  VIEW [label="Muestra la imagen y\nconfirma el guardado", group=main, penwidth=1.7];
  ERROR [label="Si falla una petición,\ncatch muestra el error"];
  subgraph cluster_row0 { style=invis; margin=8; {rank=same; UPLOAD; STORE;} }
  A -> V [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Subir imagen</TD></TR></TABLE>>];
  V -> NO [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>No</TD></TR></TABLE>>];
  V -> FORM [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Sí</TD></TR></TABLE>>];
  FORM -> UPLOAD [weight=12];
  UPLOAD -> STORE [tailport=e, headport=w, constraint=false];
  STORE -> UPLOAD [tailport=s, headport=e, constraint=false, style=dashed, color="#80a6c9"];
  UPLOAD -> PATCH [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>ID del archivo</TD></TR></TABLE>>];
  PATCH -> GET [weight=12];
  GET -> BLOB [weight=12];
  BLOB -> VIEW [weight=12];
  UPLOAD -> ERROR [style=dashed];
  PATCH -> ERROR [constraint=false, style=dashed];
  GET -> ERROR [constraint=false, style=dashed];
}
