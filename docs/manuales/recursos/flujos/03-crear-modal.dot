digraph Flujo {
  graph [rankdir=TB, bgcolor="#181818", pad="0.24", nodesep="0.42", ranksep="0.55", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#0e2a4d", color="#304b67", fontcolor="#b5d3f6", fontname="Arial", fontsize=17, penwidth=1.15, margin="0.22,0.20"];
  edge [color="#89929c", fontcolor="#b5d3f6", fontname="Arial", fontsize=13, arrowsize=0.65, penwidth=1.15];
  A [label="El usuario presiona +", group=main];
  B [label="nuevoProducto() presenta el\nmodal", group=main];
  C [label="El usuario captura los\ndatos y presiona Guardar", group=main];
  V [label="¿Formulario válido?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  INVALID [label="markAllAsTouched() y\ngetError() muestran los\nmensajes"];
  SEND [label="Axios envía los datos del\nproducto", group=main];
  API [label="Directus recibe el nuevo\nproducto", group=main];
  DB [label="MariaDB guarda el registro,\nsu ID y fecha"];
  OK [label="La app muestra Producto\nguardado", group=main];
  ACCEPT [label="Aceptar: dismiss devuelve\nguardado: true", group=main];
  LIST [label="onDidDismiss() recibe\nguardado: true y recarga", group=main];
  END [label="El listado muestra el\nproducto nuevo", group=main, penwidth=1.7];
  CANCEL [label="Cancelar: dismiss devuelve\nguardado: false"];
  CLOSE [label="Se cierra sin crear ni\nrecargar"];
  subgraph cluster_row0 { style=invis; margin=8; {rank=same; API; DB;} }
  A -> B [weight=12];
  B -> C [weight=12];
  C -> V [weight=12];
  V -> INVALID [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>No</TD></TR></TABLE>>];
  INVALID -> C [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Corregir datos</TD></TR></TABLE>>, constraint=false, style=dashed, color="#80a6c9"];
  V -> SEND [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Sí</TD></TR></TABLE>>];
  SEND -> API [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>POST /items/productos</TD></TR></TABLE>>];
  API -> DB [tailport=e, headport=w, constraint=false];
  DB -> API [tailport=s, headport=e, constraint=false, style=dashed, color="#80a6c9"];
  API -> OK [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Creación exitosa</TD></TR></TABLE>>];
  OK -> ACCEPT [weight=12];
  ACCEPT -> LIST [weight=12];
  LIST -> END [weight=12];
  B -> CANCEL [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Cancelar</TD></TR></TABLE>>, style=dashed];
  CANCEL -> CLOSE;
}
