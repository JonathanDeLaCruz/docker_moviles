flowchart TD
  A["El usuario presiona el botón del menú"]
  MENU["ion-menu abre las opciones"]
  CHOOSE["El usuario elige una opción"]
  ROUTE["routerLink cambia la ruta"]
  OUTLET["ion-router-outlet muestra la página"]
  CLOSE["ion-menu-toggle cierra el menú"]
  END["La página elegida queda visible"]
  A --> MENU
  MENU --> CHOOSE
  CHOOSE -->|"Navegación"| ROUTE
  CHOOSE -->|"Cierre del menú"| CLOSE
  ROUTE --> OUTLET
  OUTLET --> END
  CLOSE --> END
