flowchart TD
  A["El usuario escribe en el buscador"]
  INPUT["ionInput se ejecuta después de debounce"]
  SAVE["handleInput() guarda el texto y vuelve a página 1"]
  FILTER{"¿Hay texto después de trim()?"}
  YES["Crea filter con nombre y descripción"]
  NO["Utiliza un filtro vacío"]
  COUNT["Directus cuenta con ese filtro"]
  GET["Directus consulta la página con el mismo filtro"]
  DB["MariaDB aplica la búsqueda y devuelve registros"]
  END["La app muestra coincidencias y total filtrado"]
  A --> INPUT
  INPUT --> SAVE
  SAVE --> FILTER
  FILTER -->|"Sí"| YES
  FILTER -->|"No"| NO
  YES --> COUNT
  NO --> COUNT
  COUNT --> GET
  GET --> DB
  DB -.-> GET
  GET -->|"Respuesta JSON"| END
