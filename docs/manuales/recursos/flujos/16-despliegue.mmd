flowchart TD
  N0["USUARIO<br/>Abre el dominio mediante HTTPS"]
  N1["NGINX<br/>Recibe la petición<br/>Aplicación: sirve los archivos compilados de Ionic."]
  N2["NGINX<br/>Las peticiones /api/ se reenvían a Directus"]
