  N4["MARIADB<br/>Entrega los registros consultados"]
  N5["DIRECTUS<br/>Devuelve la respuesta a través de Nginx"]
  N6["APP IONIC<br/>Recibe los datos y actualiza la pantalla"]
  N0 --> N1
  N1 --> N2
  N2 --> N3
  N3 --> N4
  N4 --> N5
  N5 --> N6
