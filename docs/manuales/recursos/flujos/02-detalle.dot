digraph Flujo {
  graph [rankdir=TB, bgcolor="#181818", pad="0.24", nodesep="0.42", ranksep="0.55", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#0e2a4d", color="#304b67", fontcolor="#b5d3f6", fontname="Arial", fontsize=17, penwidth=1.15, margin="0.22,0.20"];
  edge [color="#89929c", fontcolor="#b5d3f6", fontname="Arial", fontsize=13, arrowsize=0.65, penwidth=1.15];
  A [label="El usuario presiona el\nicono de ojo", group=main];
  B [label="Router abre\nproductos-view/:id", group=main];
  C [label="ngOnInit() llama a\ncargarProducto()", group=main];
  ID [label="ActivatedRoute obtiene el\nID", group=main];
  V [label="¿Existe el ID?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  NO [label="Muestra el mensaje de ID no\nválido"];
  GET [label="Axios solicita el producto\ny activa la carga", group=main];
  API [label="Directus consulta el\nproducto por ID", group=main];
  DB [label="MariaDB entrega el registro"];
  R [label="La app guarda\nresponse.data.data en\nproducto", group=main];
  FIN [label="finally cierra el indicador\nde carga", group=main];
  OK [label="La vista muestra el\nproducto o el mensaje de\nerror", group=main, penwidth=1.7];
  ERR [label="catch muestra el mensaje de\nerror"];
  subgraph cluster_row0 { style=invis; margin=8; {rank=same; GET; NO;} }
  subgraph cluster_row1 { style=invis; margin=8; {rank=same; API; DB;} }
  A -> B [weight=12];
  B -> C [weight=12];
  C -> ID [weight=12];
  ID -> V [weight=12];
  V -> NO [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>No</TD></TR></TABLE>>];
  V -> GET [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Sí</TD></TR></TABLE>>];
  GET -> API [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>GET<BR/>/items/productos/{id}</TD></TR></TABLE>>];
  API -> DB [tailport=e, headport=w, constraint=false];
  DB -> API [tailport=s, headport=e, constraint=false, style=dashed, color="#80a6c9"];
  API -> R [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>JSON con data</TD></TR></TABLE>>];
  GET -> ERR [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Falla la consulta</TD></TR></TABLE>>, style=dashed];
  R -> FIN [weight=12];
  FIN -> OK [weight=12];
  ERR -> FIN [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Finaliza la carga</TD></TR></TABLE>>];
}
