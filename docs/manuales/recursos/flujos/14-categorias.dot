digraph Flujo {
  graph [rankdir=TB, bgcolor="#181818", pad="0.24", nodesep="0.42", ranksep="0.55", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#0e2a4d", color="#304b67", fontcolor="#b5d3f6", fontname="Arial", fontsize=17, penwidth=1.15, margin="0.22,0.20"];
  edge [color="#89929c", fontcolor="#b5d3f6", fontname="Arial", fontsize=13, arrowsize=0.65, penwidth=1.15];
  A [label="La app abre el formulario", group=main];
  CAT [label="Consulta el catálogo de\ncategorías", group=main];
  MODE [label="¿Está editando?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  LOAD [label="Consulta el producto y sus\nenlaces", group=main];
  FILL [label="patchValue y FormArray\ncargan selecciones", group=main];
  NEW [label="Formulario nuevo con\ncategorías opcionales"];
  EDIT [label="El usuario agrega, cambia o\nquita filas", group=main];
  VALID [label="¿Formulario válido?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  ERR [label="Muestra validaciones"];
  IDS [label="Set reúne IDs únicos", group=main];
  SAVE [label="¿Crear o actualizar?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  POST [label="POST envía categorias_id de\ncada selección"];
  PATCH [label="PATCH envía create y delete\nde enlaces", group=main];
  DB [label="Directus guarda producto y\nasociaciones", group=main];
  DETAIL [label="El detalle consulta\ncategorías expandidas", group=main];
  VIEW [label="Muestra los nombres o Sin\ncategorías asignadas", group=main, penwidth=1.7];
  subgraph cluster_row0 { style=invis; margin=8; {rank=same; LOAD; NEW;} }
  subgraph cluster_row1 { style=invis; margin=8; {rank=same; POST; PATCH;} }
  A -> CAT [weight=12];
  CAT -> MODE [weight=12];
  MODE -> LOAD [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Sí</TD></TR></TABLE>>];
  LOAD -> FILL [weight=12];
  FILL -> EDIT [weight=12];
  MODE -> NEW [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>No</TD></TR></TABLE>>];
  NEW -> EDIT;
  EDIT -> VALID [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Guardar</TD></TR></TABLE>>];
  VALID -> ERR [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>No</TD></TR></TABLE>>];
  ERR -> EDIT [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Corregir</TD></TR></TABLE>>, constraint=false, style=dashed, color="#80a6c9"];
  VALID -> IDS [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Sí</TD></TR></TABLE>>];
  IDS -> SAVE [weight=12];
  SAVE -> POST [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Crear</TD></TR></TABLE>>];
  SAVE -> PATCH [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Actualizar</TD></TR></TABLE>>];
  POST -> DB;
  PATCH -> DB [weight=12];
  DB -> DETAIL [weight=12];
  DETAIL -> VIEW [weight=12];
}
