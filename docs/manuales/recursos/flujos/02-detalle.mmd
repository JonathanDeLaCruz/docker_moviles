flowchart TD
  A["El usuario presiona el icono de ojo"]
  B["Router abre productos-view/:id"]
  C["ngOnInit() llama a cargarProducto()"]
  ID["ActivatedRoute obtiene el ID"]
  V{"¿Existe el ID?"}
  NO["Muestra el mensaje de ID no válido"]
  GET["Axios solicita el producto y activa la carga"]
  API["Directus consulta el producto por ID"]
  DB["MariaDB entrega el registro"]
  R["La app guarda response.data.data en producto"]
  FIN["finally cierra el indicador de carga"]
  OK["La vista muestra el producto o el mensaje de error"]
  ERR["catch muestra el mensaje de error"]
  A --> B
  B --> C
  C --> ID
  ID --> V
  V -->|"No"| NO
  V -->|"Sí"| GET
  GET -->|"GET /items/productos/{id}"| API
  API --> DB
  DB -.-> API
  API -->|"JSON con data"| R
  GET -.->|"Falla la consulta"| ERR
  R --> FIN
  FIN --> OK
  ERR -->|"Finaliza la carga"| FIN
