flowchart TD
  A["El usuario solicita una ruta protegida"]
  GUARD["authGuard llama a validarSesion()"]
  CHECK["AuthService comprueba la sesión con Directus"]
  VALID{"¿Sesión válida?"}
  PAGE["Permite abrir la página solicitada"]
  LOGIN["Devuelve Login con returnUrl"]
  AUTH["El usuario inicia sesión"]
  RETURN["Router vuelve al destino y ejecuta el guard"]
  A --> GUARD
  GUARD --> CHECK
  CHECK --> VALID
  VALID -->|"Sí"| PAGE
  VALID -->|"No"| LOGIN
  LOGIN --> AUTH
  AUTH --> RETURN
  RETURN -.->|"Revalidar"| GUARD
