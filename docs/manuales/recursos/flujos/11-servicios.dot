digraph Flujo {
  graph [rankdir=TB, bgcolor="#181818", pad="0.24", nodesep="0.42", ranksep="0.55", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#0e2a4d", color="#304b67", fontcolor="#b5d3f6", fontname="Arial", fontsize=17, penwidth=1.15, margin="0.22,0.20"];
  edge [color="#89929c", fontcolor="#b5d3f6", fontname="Arial", fontsize=13, arrowsize=0.65, penwidth=1.15];
  A [label="La página llama a\nProductosService", group=main];
  OBS [label="El servicio devuelve un\nObservable", group=main];
  SUB [label="firstValueFrom() se\nsuscribe", group=main];
  CALL [label="defer() ejecuta la llamada\nAxios", group=main];
  API [label="Directus procesa la\noperación", group=main];
  DB [label="MariaDB consulta o modifica\nlos datos"];
  MAP [label="map() extrae o transforma\nla respuesta", group=main];
  RESULT [label="firstValueFrom() resuelve\nla promesa", group=main];
  VIEW [label="La página actualiza su\nvista", group=main, penwidth=1.7];
  ERROR [label="La promesa se rechaza y el\ncatch de la página maneja\nel error"];
  subgraph cluster_row0 { style=invis; margin=8; {rank=same; API; DB;} }
  A -> OBS [weight=12];
  OBS -> SUB [weight=12];
  SUB -> CALL [weight=12];
  CALL -> API [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Petición HTTP</TD></TR></TABLE>>];
  API -> DB [tailport=e, headport=w, constraint=false];
  DB -> API [tailport=s, headport=e, constraint=false, style=dashed, color="#80a6c9"];
  API -> MAP [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Respuesta</TD></TR></TABLE>>];
  MAP -> RESULT [weight=12];
  RESULT -> VIEW [weight=12];
  CALL -> ERROR [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Falla la petición</TD></TR></TABLE>>, style=dashed];
}
