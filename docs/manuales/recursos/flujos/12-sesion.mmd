flowchart TD
  A["El usuario abre la app"]
  CHOOSE{"¿Tiene una cuenta activa?"}
  REG["Valida y envía el formulario de registro"]
  REGISTER["Directus recibe POST /users/register"]
  VERIFY["Verifica el correo si se requiere"]
  LOGIN["Valida el formulario de acceso"]
  AUTH["AuthService envía POST /auth/login"]
  VALID{"¿Acceso aceptado?"}
  ERROR["Muestra el mensaje de acceso fallido"]
  SESSION["Guarda los tokens y su vigencia en memoria"]
  NAV["Abre el destino o el listado"]
  BEARER["El cliente agrega Bearer a las consultas"]
  PERMS["Directus aplica los permisos de la cuenta"]
  A --> CHOOSE
  CHOOSE -->|"No: Crear cuenta"| REG
  CHOOSE -->|"Sí"| LOGIN
  REG --> REGISTER
  REGISTER --> VERIFY
  VERIFY -.->|"Continuar al acceso"| LOGIN
  LOGIN --> AUTH
  AUTH --> VALID
  VALID -->|"No"| ERROR
  VALID -->|"Sí"| SESSION
  SESSION --> NAV
  NAV --> BEARER
  BEARER --> PERMS
