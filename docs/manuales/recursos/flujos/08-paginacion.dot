digraph Flujo {
  graph [rankdir=TB, bgcolor="#181818", pad="0.24", nodesep="0.42", ranksep="0.55", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#0e2a4d", color="#304b67", fontcolor="#b5d3f6", fontname="Arial", fontsize=17, penwidth=1.15, margin="0.22,0.20"];
  edge [color="#89929c", fontcolor="#b5d3f6", fontname="Arial", fontsize=13, arrowsize=0.65, penwidth=1.15];
  A [label="El usuario abre el listado", group=main];
  COUNT [label="cargarTotal() solicita el\nconteo a Directus", group=main];
  TOTAL [label="La app ajusta total y\npaginaActual", group=main];
  GET [label="Directus procesa GET con\nlimit, page y sort", group=main];
  DB [label="MariaDB entrega los\nregistros solicitados"];
  VIEW [label="La app muestra la lista y\napp-paginacion", group=main, penwidth=1.7];
  SELECT [label="El usuario selecciona otra\npágina", group=main];
  V [label="¿Página válida y\ndistinta?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  NO [label="El componente no emite\nningún cambio"];
  CHANGE [label="paginaCambio actualiza\npaginaActual", group=main];
  subgraph cluster_row0 { style=invis; margin=8; {rank=same; GET; DB;} }
  A -> COUNT [weight=12];
  COUNT -> TOTAL [weight=12];
  TOTAL -> GET [weight=12];
  GET -> DB [tailport=e, headport=w, constraint=false];
  DB -> GET [tailport=s, headport=e, constraint=false, style=dashed, color="#80a6c9"];
  GET -> VIEW [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Registros de la<BR/>página</TD></TR></TABLE>>];
  VIEW -> SELECT [weight=12];
  SELECT -> V [weight=12];
  V -> NO [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>No</TD></TR></TABLE>>];
  V -> CHANGE [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Sí</TD></TR></TABLE>>];
  CHANGE -> GET [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Nueva consulta</TD></TR></TABLE>>, constraint=false, style=dashed, color="#80a6c9"];
}
