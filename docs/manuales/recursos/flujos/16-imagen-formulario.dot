digraph Flujo {
  graph [rankdir=TB, bgcolor="#181818", pad="0.24", nodesep="0.42", ranksep="0.55", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#0e2a4d", color="#304b67", fontcolor="#b5d3f6", fontname="Arial", fontsize=17, penwidth=1.15, margin="0.22,0.20"];
  edge [color="#89929c", fontcolor="#b5d3f6", fontname="Arial", fontsize=13, arrowsize=0.65, penwidth=1.15];
  A [label="El usuario abre Crear o\nEditar producto", group=main];
  LOAD [label="En edición carga datos,\ncategorías e imagen", group=main];
  SELECT [label="Captura datos y selecciona\nimagen opcional", group=main];
  VALID [label="¿Formulario válido?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  BAD [label="Muestra las validaciones"];
  FILE [label="¿Hay un archivo\nnuevo?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  UP [label="FormData envía POST /files\na Directus", group=main];
  ID [label="Conserva el ID devuelto y\nlimpia archivo pendiente", group=main];
  KEEP [label="Conserva la imagen\nexistente o sin imagen"];
  MODE [label="¿Crear o actualizar?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  POST [label="POST crea producto, imagen\ny categorías", group=main];
  PATCH [label="PATCH actualiza datos,\nimagen y enlaces"];
  OK [label="Confirma y regresa al\nlistado", group=main];
  DETAIL [label="El detalle consulta\nproducto y categorías", group=main];
  GET [label="Si tiene imagen, GET\n/assets/{id} autenticado", group=main];
  VIEW [label="Blob muestra la imagen\njunto a datos y categorías", group=main, penwidth=1.7];
  subgraph cluster_row0 { style=invis; margin=8; {rank=same; UP; KEEP;} }
  subgraph cluster_row1 { style=invis; margin=8; {rank=same; POST; PATCH;} }
  A -> LOAD [weight=12];
  LOAD -> SELECT [weight=12];
  SELECT -> VALID [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Guardar</TD></TR></TABLE>>];
  VALID -> BAD [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>No</TD></TR></TABLE>>];
  BAD -> SELECT [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Corregir</TD></TR></TABLE>>, constraint=false, style=dashed, color="#80a6c9"];
  VALID -> FILE [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Sí</TD></TR></TABLE>>];
  FILE -> UP [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Sí</TD></TR></TABLE>>];
  UP -> ID [weight=12];
  FILE -> KEEP [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>No</TD></TR></TABLE>>];
  ID -> MODE [weight=12];
  KEEP -> MODE;
  MODE -> POST [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Crear</TD></TR></TABLE>>];
  MODE -> PATCH [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Actualizar</TD></TR></TABLE>>];
  POST -> OK [weight=12];
  PATCH -> OK;
  OK -> DETAIL [weight=12];
  DETAIL -> GET [weight=12];
  GET -> VIEW [weight=12];
}
