digraph Flujo {
  graph [rankdir=TB, bgcolor="#181818", pad="0.24", nodesep="0.42", ranksep="0.55", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#0e2a4d", color="#304b67", fontcolor="#b5d3f6", fontname="Arial", fontsize=17, penwidth=1.15, margin="0.22,0.20"];
  edge [color="#89929c", fontcolor="#b5d3f6", fontname="Arial", fontsize=13, arrowsize=0.65, penwidth=1.15];
  A [label="El usuario escribe en el\nbuscador", group=main];
  INPUT [label="ionInput se ejecuta después\nde debounce", group=main];
  SAVE [label="handleInput() guarda el\ntexto y vuelve a página 1", group=main];
  FILTER [label="¿Hay texto después\nde trim()?", group=main, shape=diamond, style=filled, margin="0.12,0.08"];
  YES [label="Crea filter con nombre y\ndescripción", group=main];
  NO [label="Utiliza un filtro vacío"];
  COUNT [label="Directus cuenta con ese\nfiltro", group=main];
  GET [label="Directus consulta la página\ncon el mismo filtro", group=main];
  DB [label="MariaDB aplica la búsqueda\ny devuelve registros"];
  END [label="La app muestra\ncoincidencias y total\nfiltrado", group=main, penwidth=1.7];
  subgraph cluster_row0 { style=invis; margin=8; {rank=same; YES; NO;} }
  subgraph cluster_row1 { style=invis; margin=8; {rank=same; GET; DB;} }
  A -> INPUT [weight=12];
  INPUT -> SAVE [weight=12];
  SAVE -> FILTER [weight=12];
  FILTER -> YES [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Sí</TD></TR></TABLE>>];
  FILTER -> NO [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>No</TD></TR></TABLE>>];
  YES -> COUNT [weight=12];
  NO -> COUNT;
  COUNT -> GET [weight=12];
  GET -> DB [tailport=e, headport=w, constraint=false];
  DB -> GET [tailport=s, headport=e, constraint=false, style=dashed, color="#80a6c9"];
  GET -> END [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Respuesta JSON</TD></TR></TABLE>>];
}
