digraph Flujo {
  graph [rankdir=TB, bgcolor="#181818", pad="0.24", nodesep="0.42", ranksep="0.55", splines=spline, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#0e2a4d", color="#304b67", fontcolor="#b5d3f6", fontname="Arial", fontsize=17, penwidth=1.15, margin="0.22,0.20"];
  edge [color="#89929c", fontcolor="#b5d3f6", fontname="Arial", fontsize=13, arrowsize=0.65, penwidth=1.15];
  APP [label="Aplicación Ionic", group=main];
  API [label="Directus: API, sesión y\npermisos", group=main];
  DB [label="MariaDB: datos del proyecto"];
  SWAGGER [label="Swagger UI consulta OpenAPI"];
  CLOUD [label="CloudBeaver administra la\nbase"];
  VIEW [label="Ionic muestra el resultado\nen pantalla", group=main, penwidth=1.7];
  subgraph cluster_row0 { style=invis; margin=8; {rank=same; APP; SWAGGER;} }
  subgraph cluster_row1 { style=invis; margin=8; {rank=same; API; CLOUD;} }
  APP -> API [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>HTTP / JSON</TD></TR></TABLE>>];
  API -> DB [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Consulta</TD></TR></TABLE>>];
  DB -> API [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Datos</TD></TR></TABLE>>, constraint=false, style=dashed, color="#80a6c9"];
  API -> VIEW [weight=12, label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Respuesta JSON</TD></TR></TABLE>>];
  SWAGGER -> API [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Especificación<BR/>OpenAPI</TD></TR></TABLE>>];
  CLOUD -> DB [label=<<TABLE BORDER="0" CELLBORDER="0" COLOR="#304b67" BGCOLOR="#101820" CELLPADDING="4" CELLSPACING="0" ><TR><TD>Administración</TD></TR></TABLE>>];
}
