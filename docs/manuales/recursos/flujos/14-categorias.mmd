flowchart TD
  A["La app abre el formulario"]
  CAT["Consulta el catálogo de categorías"]
  MODE{"¿Está editando?"}
  LOAD["Consulta el producto y sus enlaces"]
  FILL["patchValue y FormArray cargan selecciones"]
  NEW["Formulario nuevo con categorías opcionales"]
  EDIT["El usuario agrega, cambia o quita filas"]
  VALID{"¿Formulario válido?"}
  ERR["Muestra validaciones"]
  IDS["Set reúne IDs únicos"]
  SAVE{"¿Crear o actualizar?"}
  POST["POST envía categorias_id de cada selección"]
  PATCH["PATCH envía create y delete de enlaces"]
  DB["Directus guarda producto y asociaciones"]
  DETAIL["El detalle consulta categorías expandidas"]
  VIEW["Muestra los nombres o Sin categorías asignadas"]
  A --> CAT
  CAT --> MODE
  MODE -->|"Sí"| LOAD
  LOAD --> FILL
  FILL --> EDIT
  MODE -->|"No"| NEW
  NEW --> EDIT
  EDIT -->|"Guardar"| VALID
  VALID -->|"No"| ERR
  ERR -.->|"Corregir"| EDIT
  VALID -->|"Sí"| IDS
  IDS --> SAVE
  SAVE -->|"Crear"| POST
  SAVE -->|"Actualizar"| PATCH
  POST --> DB
  PATCH --> DB
  DB --> DETAIL
  DETAIL --> VIEW
