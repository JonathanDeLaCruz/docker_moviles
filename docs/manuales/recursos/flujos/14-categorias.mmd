flowchart TD
  A["Se abre el formulario de creación"]
  LOAD["CategoriasService consulta Directus"]
  OPTIONS["La app recibe las categorías disponibles"]
  FORM["El usuario completa los datos del producto"]
  PLUS["+ agrega una fila al FormArray"]
  SELECT["El usuario elige la categoría de cada fila"]
  TRASH["La papelera quita una fila"]
  VALID{"¿Formulario y selecciones válidos?"}
  INVALID["Muestra validaciones y permite corregir"]
  JSON["Convierte IDs, elimina repetidos con Set y prepara enlaces"]
  POST["Directus recibe POST del producto con categorias"]
  DB["MariaDB guarda producto y filas de productos_categorias"]
  DONE["La app muestra la confirmación"]
  A --> LOAD
  LOAD --> OPTIONS
  OPTIONS --> FORM
  FORM --> PLUS
  PLUS --> SELECT
  SELECT -->|"Quitar fila"| TRASH
  TRASH -.->|"Selecciones restantes"| SELECT
  SELECT -->|"Guardar"| VALID
  VALID -->|"No"| INVALID
  INVALID -.->|"Corregir"| SELECT
  VALID -->|"Sí"| JSON
  JSON --> POST
  POST --> DB
  DB -.-> POST
  POST -->|"Creación exitosa"| DONE
  SELECT -.->|"Agregar otra"| PLUS
